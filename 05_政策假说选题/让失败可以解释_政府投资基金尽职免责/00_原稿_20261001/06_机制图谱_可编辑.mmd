flowchart TB
    subgraph A["本期事前：提出并验证的信息结构"]
        A1["原始依据有版本<br/>本层修改有来源与理由"] --> A2["后续有权审查者<br/>能够跨层还原当时信息"]
        A2 --> A3["管理人预期：<br/>正常失败与失职更可区分"]
        A3 --> A4["免责承诺更可信<br/>认定程序更可预期"]
        A4 --> A5["履职者的不当归责预期下降<br/>失职者仍受到约束"]
        C["必要条件：证据可核验；有效认定权限；规则稳定；专业自主权"] -.-> A2
        C -.-> A4
    end
    subgraph B["本期及后续行为：三个可以分别检验的分支"]
        B1["投：选择有价值的探索<br/>设置匹配技术进程的合同"]
        B2["管：及时报告坏消息<br/>按新信息调整与继续"]
        B3["退：承认正常损失<br/>价值不足时及时退出"]
    end
    A5 --> B1
    A5 --> B2
    A5 --> B3
    B1 --> D1["有价值项目减少过早中断"]
    B2 --> D1
    B2 --> D2["更早学习并修正技术路线"]
    B3 --> D3["释放资金与专业人员"]
    D1 --> E["拟检验结果：<br/>探索连续性与资本配置改善"]
    D2 --> E
    D3 --> E
    E -.-> F["远端扩展：创新扩散、生产率与税基<br/>须另计挤出效应、核查成本与真实回收"]
    A2 --> G["项目事后：实际责任认定<br/>正常失败、失职与隐瞒是否分清"]
    B2 --> G
    G --> H["下一期：依据真实案例更新信任<br/>影响下一轮投资、报告与退出"]
    subgraph R["竞争机制：可能打断或逆转主线"]
        R1["留痕负担增加<br/>挤占真实专业工作"]
        R2["跨层访问演变为逐笔指令<br/>诱发迎合与保守"]
        R3["材料造假或串通<br/>直接路径传播错误"]
        R4["准确认定无法约束追责<br/>承诺仍不可信"]
    end
    R1 -. "抑制" .-> B1
    R2 -. "抑制" .-> B2
    R3 -. "削弱" .-> A2
    R4 -. "阻断" .-> A4
    classDef design fill:#e9f1ff,stroke:#4169a4,color:#162c4e;
    classDef behavior fill:#e9f5f0,stroke:#4f8876,color:#1c4b3d;
    classDef risk fill:#fff0ec,stroke:#bc796a,color:#743e32;
    classDef extension fill:#f2f0f8,stroke:#9486ab,color:#483963;
    class A1,A2,A3,A4,A5 design;
    class B1,B2,B3,D1,D2,D3,E behavior;
    class R1,R2,R3,R4 risk;
    class F,G,H extension;

